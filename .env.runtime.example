# Normal application runtime configuration. Copy to .env.runtime on the server.
# This database role must not own the schema and must not have migration rights.
# connection_limit keeps one app container well under Postgres max_connections (100)
# even while the migration profile runs alongside; pool_timeout bounds waits.
DATABASE_URL="postgresql://sana_runtime:replace-with-runtime-password@postgres:5432/sana?connection_limit=10&pool_timeout=10"

APP_URL="https://sana.ioiv.ir"
SESSION_SECRET="replace-with-a-long-random-secret-minimum-32-characters"
UPLOAD_DIR="/app/uploads"

# Facilities M2 private storage and malware scanner. Facilities must remain disabled
# unless a monitored clamd service is provisioned and these values are verified.
# Note: the FACILITIES_SCANNER_DEV_PASSTHROUGH dev opt-in is ignored here because the
# app runs with NODE_ENV=production; scanning always requires a reachable clamd.
FACILITIES_UPLOAD_DIR="/app/uploads/facilities-private"
FACILITIES_CLAMAV_HOST="clamd"
FACILITIES_CLAMAV_PORT="3310"
FACILITIES_CLAMAV_TIMEOUT_MS="15000"
FACILITIES_CLAMAV_CHUNK_SIZE="65536"
# Concurrent clamd scans (keep below clamd MaxThreads) and how long an upload may
# wait for a scan slot before it is retained as UNAVAILABLE for a later retry.
FACILITIES_SCAN_CONCURRENCY="4"
FACILITIES_SCAN_QUEUE_TIMEOUT_MS="20000"
FACILITIES_ORPHAN_TTL_MS="86400000"
# M8 keeps scanner/storage-unavailable bytes for exactly 24 hours. This value is
# documented for operators; application code fails closed and does not permit a
# longer production retention window.
FACILITIES_UNAVAILABLE_RETENTION_MS="86400000"

# M9 scheduler/monitoring state belongs on the host, not in the app container.
# Pin the optional operations/facilities-m9 ClamAV image by digest in protected
# Compose interpolation configuration; do not put that deployment value here.

# Payment
ZARINPAL_MERCHANT_ID="replace-with-production-zarinpal-merchant-id"
ZARINPAL_SANDBOX="false"
# Per-call gateway timeout in ms (1000-30000, default 10000).
ZARINPAL_REQUEST_TIMEOUT_MS="10000"

# SMS
GHASEDAK_API_KEY="replace-with-production-ghasedak-api-key"
# Must be https:// in production. Set GHASEDAK_ALLOW_INSECURE_HTTP="true" only during a
# provider certificate outage; the app logs sms_insecure_transport while it is active.
GHASEDAK_BASE_URL="https://api.smsapp.ir/v2"
GHASEDAK_OTP_TEMPLATE="sanaotp"
GHASEDAK_STATUS_TEMPLATE="sanastatus"
GHASEDAK_SUBMITTED_TEMPLATE="sanasubmitted"
GHASEDAK_FACILITIES_CORRECTION_TEMPLATE="sanacorrection"
SMS_REQUEST_TIMEOUT_MS="10000"
GHASEDAK_SENDER="replace-if-ghasedak-requires-a-sender"
SMS_SEND_IN_DEVELOPMENT="false"

# Notifications and non-production seed controls
ADMIN_ALERT_MOBILE="replace-with-admin-alert-mobile"
# Required by `npm run db:seed`; the seed no longer hardcodes admin mobiles and never
# changes admins that already exist.
SEED_ADMIN_MOBILES="replace-with-comma-separated-admin-mobiles"
SEED_DEMO_DATA="false"

# OTP requests per client address per hour (default 30). Lower only after
# confirming X-Real-IP carries end-user addresses (DEPLOYMENT.md, hardening phase 2).
OTP_MAX_REQUESTS_PER_IP_PER_WINDOW="30"

# Upload admission control (process-local; see DEPLOYMENT.md). Bodies buffered at
# once per user / in total, and uploads per sliding hour per user / per client IP.
# Keep UPLOAD_MAX_IN_FLIGHT_GLOBAL * 50 MiB well below the container memory limit.
UPLOAD_MAX_IN_FLIGHT_PER_USER="2"
UPLOAD_MAX_IN_FLIGHT_GLOBAL="6"
UPLOAD_MAX_PER_USER_PER_HOUR="60"
UPLOAD_MAX_PER_IP_PER_HOUR="120"

# Normal application runtime configuration. Copy to .env.runtime on the server.
# This database role must not own the schema and must not have migration rights.
DATABASE_URL="postgresql://sana_runtime:replace-with-runtime-password@postgres:5432/sana"

APP_URL="https://sana.ioiv.ir"
SESSION_SECRET="replace-with-a-long-random-secret-minimum-32-characters"
UPLOAD_DIR="/app/uploads"

# Facilities M2 private storage and malware scanner. Facilities must remain disabled
# unless a monitored clamd service is provisioned and these values are verified.
FACILITIES_UPLOAD_DIR="/app/uploads/facilities-private"
FACILITIES_CLAMAV_HOST="clamd"
FACILITIES_CLAMAV_PORT="3310"
FACILITIES_CLAMAV_TIMEOUT_MS="15000"
FACILITIES_CLAMAV_CHUNK_SIZE="65536"
FACILITIES_ORPHAN_TTL_MS="86400000"

# Payment
ZARINPAL_MERCHANT_ID="replace-with-production-zarinpal-merchant-id"
ZARINPAL_SANDBOX="false"

# SMS
GHASEDAK_API_KEY="replace-with-production-ghasedak-api-key"
GHASEDAK_BASE_URL="http://api.smsapp.ir/v2"
GHASEDAK_OTP_TEMPLATE="sanaotp"
GHASEDAK_STATUS_TEMPLATE="sanastatus"
GHASEDAK_SUBMITTED_TEMPLATE="sanasubmitted"
GHASEDAK_SENDER="replace-if-ghasedak-requires-a-sender"
SMS_SEND_IN_DEVELOPMENT="false"

# Notifications and non-production seed controls
ADMIN_ALERT_MOBILE="replace-with-admin-alert-mobile"
SEED_ADMIN_MOBILE="replace-with-admin-mobile"
SEED_ADMIN_MOBILES="replace-with-admin-mobile"
SEED_DEMO_DATA="false"
